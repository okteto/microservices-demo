{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug result (Node.js)",
            "type": "node",
            "request": "attach",
            "port": 9229,
            "address": "localhost",
            "restart": true,
            "sourceMaps": false,
            "localRoot": "${workspaceFolder}/result",
            "remoteRoot": "/app",
            "timeout": 10000
        },
        {
            "name": "Debug vote (Java)",
            "type": "java",
            "request": "attach",
            "hostName": "localhost",
            "port": 5005
        },
        {
            "name": "Debug worker (Go)",
            "type": "go",
            "request": "attach",
            "mode": "remote",
            "remotePath": "/app",
            "port": 2345,
            "host": "127.0.0.1"
        }
    ]
}
